<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="104dp"
    android:height="96dp"
    android:viewportWidth="104"
    android:viewportHeight="96">

    <!-- A car is about twice as long as it is wide; the artwork is drawn wide and squashed
         into that proportion here so every panel keeps its relative size. -->
    <group android:scaleX="0.70" android:scaleY="1.50" android:pivotX="60" android:pivotY="32" android:translateX="-8" android:translateY="16">

    <!-- Mirrors, drawn under the body so only their tips show. -->
    <path
        android:fillColor="#0A5F52"
        android:pathData="M30,22 h-4 a2,2 0 0 0 -2,2 v3 a2,2 0 0 0 2,2 h4 z" />
    <path
        android:fillColor="#0A5F52"
        android:pathData="M90,22 h4 a2,2 0 0 1 2,2 v3 a2,2 0 0 1 -2,2 h-4 z" />

    <!-- Tyres: four dark blocks that read as rubber at 40 px. -->
    <path
        android:fillColor="#141C22"
        android:pathData="M26,13 h6 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-6 a2,2 0 0 1 -2,-2 v-8 a2,2 0 0 1 2,-2 z" />
    <path
        android:fillColor="#141C22"
        android:pathData="M26,41 h6 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-6 a2,2 0 0 1 -2,-2 v-8 a2,2 0 0 1 2,-2 z" />
    <path
        android:fillColor="#141C22"
        android:pathData="M88,13 h6 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-6 a2,2 0 0 1 -2,-2 v-8 a2,2 0 0 1 2,-2 z" />
    <path
        android:fillColor="#141C22"
        android:pathData="M88,41 h6 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-6 a2,2 0 0 1 -2,-2 v-8 a2,2 0 0 1 2,-2 z" />

    <!-- White rim: the car has to read against tarmac, water and night styles alike. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,1 h40 a12,12 0 0 1 12,12 v38 a12,12 0 0 1 -12,12 h-40 a12,12 0 0 1 -12,-12 v-38 a12,12 0 0 1 12,-12 z" />

    <!-- Body shell with a nose taper: shading reads as a raised surface from above. -->
    <path
        android:fillColor="#0E8C74"
        android:pathData="M38,3 h44 a10,10 0 0 1 10,10 v38 a10,10 0 0 1 -10,10 h-44 a10,10 0 0 1 -10,-10 v-38 a10,10 0 0 1 10,-10 z" />
    <path
        android:fillColor="#12A98D"
        android:pathData="M40,5 h40 a8,8 0 0 1 8,8 v37 a8,8 0 0 1 -8,8 h-40 a8,8 0 0 1 -8,-8 v-37 a8,8 0 0 1 8,-8 z" />
    <path
        android:fillColor="#1FC6A6"
        android:pathData="M42,7 h36 a6,6 0 0 1 6,6 v7 h-48 v-7 a6,6 0 0 1 6,-6 z" />

    <!-- Bonnet creases: two hairlines that give the panel some shape. -->
    <path
        android:strokeColor="#0B6E5C"
        android:strokeWidth="1.1"
        android:strokeAlpha="0.55"
        android:pathData="M46,9 v9 M74,9 v9" />

    <!-- Windshield and rear glass, angled so the car reads as facing up. -->
    <path
        android:fillColor="#0B2733"
        android:pathData="M44,18 h32 a4,4 0 0 1 4,4 v4 a4,4 0 0 1 -4,4 h-32 a4,4 0 0 1 -4,-4 v-4 a4,4 0 0 1 4,-4 z" />
    <path
        android:fillColor="#143F4E"
        android:pathData="M46,19.5 h28 a3,3 0 0 1 3,3 v2 a3,3 0 0 1 -3,3 h-28 a3,3 0 0 1 -3,-3 v-2 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#0B2733"
        android:pathData="M46,45 h28 a4,4 0 0 1 4,4 v2 a4,4 0 0 1 -4,4 h-28 a4,4 0 0 1 -4,-4 v-2 a4,4 0 0 1 4,-4 z" />

    <!-- Roof: the lit panel between the two panes. -->
    <path
        android:fillColor="#28D6B6"
        android:pathData="M47,30 h26 a3,3 0 0 1 3,3 v10 a3,3 0 0 1 -3,3 h-26 a3,3 0 0 1 -3,-3 v-10 a3,3 0 0 1 3,-3 z" />
    <path
        android:fillColor="#3AE7C8"
        android:pathData="M50,32 h20 a2,2 0 0 1 2,2 v7 a2,2 0 0 1 -2,2 h-20 a2,2 0 0 1 -2,-2 v-7 a2,2 0 0 1 2,-2 z" />

    <!-- Headlights (front, top) and tail lights (rear, bottom). -->
    <path
        android:fillColor="#F7FFFD"
        android:pathData="M40,5.5 h9 a2,2 0 0 1 2,2 v1.5 a2,2 0 0 1 -2,2 h-9 a2,2 0 0 1 -2,-2 v-1.5 a2,2 0 0 1 2,-2 z" />
    <path
        android:fillColor="#F7FFFD"
        android:pathData="M71,5.5 h9 a2,2 0 0 1 2,2 v1.5 a2,2 0 0 1 -2,2 h-9 a2,2 0 0 1 -2,-2 v-1.5 a2,2 0 0 1 2,-2 z" />
    <path
        android:fillColor="#FF5A48"
        android:pathData="M40,56.5 h9 a2,2 0 0 1 2,2 v1.5 a2,2 0 0 1 -2,2 h-9 a2,2 0 0 1 -2,-2 v-1.5 a2,2 0 0 1 2,-2 z" />
    <path
        android:fillColor="#FF5A48"
        android:pathData="M71,56.5 h9 a2,2 0 0 1 2,2 v1.5 a2,2 0 0 1 -2,2 h-9 a2,2 0 0 1 -2,-2 v-1.5 a2,2 0 0 1 2,-2 z" />

    <!-- Centre line down the bonnet: cheap perspective cue at small sizes. -->
    <path
        android:strokeColor="#EAFBF6"
        android:strokeWidth="1.4"
        android:strokeAlpha="0.75"
        android:pathData="M60,8 v8" />
    </group>
</vector>
